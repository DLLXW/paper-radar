# ============================================================
# PaperRadar 环境变量示例（复制为 backend/.env 使用）
#
# 唯一必填：RADAR_LLM_API_KEY。其余全部可选，留空即用默认值。
# 研究画像（分类/关键词/排除词/每日上限）不在这里——
#   存数据库、在 Web「设置」面板里改。
# 凭证只进本文件（.env 已被 .gitignore 忽略），绝不提交仓库。
# ============================================================

# ---------- LLM 打分（唯一必填） ----------
# OpenAI 兼容 API key。默认指向 DeepSeek：
#   1. 打开 https://platform.deepseek.com/ 注册/登录
#   2. 左侧「API Keys」→ 创建 key（sk- 开头），复制填到下面
#   3. 充值几元即可长期使用（打分一篇约零点几厘钱）
# 不配置也能跑：抓取与速递台照常，只是论文没有分数和理由。
RADAR_LLM_API_KEY=

# OpenAI 兼容 base URL。用 DeepSeek 保持默认即可；
# 换 OpenAI 填 https://api.openai.com/v1；自建网关填其地址。
RADAR_LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（DeepSeek 默认 deepseek-chat；OpenAI 如 gpt-4o-mini）
RADAR_LLM_MODEL=deepseek-chat

# ---------- 服务 ----------
# RADAR_HOST=0.0.0.0
# RADAR_PORT=8300
# RADAR_DEBUG=false

# ---------- 抓取与保留 ----------
# 每日定时抓取时刻（本地时间的小时数，0-23），默认早上 8 点
# RADAR_PAPER_FETCH_HOUR=8
# 论文保留天数（超期自动清理，含星标，请及时精读/导出），默认 90
# RADAR_PAPER_RETENTION_DAYS=90

# ---------- 推送：飞书（可选） ----------
# 飞书群「自定义机器人」webhook：
#   1. 飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人
#   2. 安全设置勾选「自定义关键词」，填：PaperRadar
#      （我们的消息主题含 "PaperRadar"，可通过校验）
#   3. 复制生成的 webhook 地址填到下面
RADAR_FEISHU_WEBHOOK_URL=

# ---------- 推送：邮件 SMTP（可选，587 端口 STARTTLS） ----------
# 注意：绝大多数邮箱要用「授权码」而不是登录密码——
#   QQ 邮箱：设置 → 账号 → 开启 SMTP 服务 → 生成授权码
#   163 邮箱：设置 → POP3/SMTP/IMAP → 开启 → 设置授权码
#   Gmail：Google 账号 → 安全性 → 两步验证 → 应用专用密码
# RADAR_SMTP_HOST=smtp.qq.com
# RADAR_SMTP_PORT=587
# RADAR_SMTP_USER=you@example.com
# RADAR_SMTP_PASSWORD=你的授权码
# RADAR_SMTP_FROM=you@example.com
# RADAR_SMTP_TO=you@example.com

# ---------- 精读服务（可选插件） ----------
# 指向 local_ai_toolkit 等 reader 实例的 base URL（不带尾斜杠），
# 需要其提供 POST /api/upload/url（传 arXiv PDF 链接，返回任务）。
# 配置后速递卡片出现「去精读」按钮：全文 OCR + 翻译 + 双语阅读。
# 示例：RADAR_READER_BASE_URL=http://127.0.0.1:8000
RADAR_READER_BASE_URL=

# ---------- 存储 ----------
# SQLite 数据目录（默认 backend/data/；Docker 内已固定为 /data 卷）
# RADAR_DATA_DIR=
